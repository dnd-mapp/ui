{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "analytics": false,
        "packageManager": "pnpm"
    },
    "newProjectRoot": "projects",
    "projects": {
        "ui": {
            "projectType": "library",
            "root": "projects/ui",
            "sourceRoot": "projects/ui",
            "prefix": "dma",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "type": "component"
                },
                "@schematics/angular:directive": {
                    "type": "directive"
                },
                "@schematics/angular:service": {
                    "type": "service"
                },
                "@schematics/angular:guard": {
                    "typeSeparator": "."
                },
                "@schematics/angular:interceptor": {
                    "typeSeparator": "."
                },
                "@schematics/angular:module": {
                    "typeSeparator": "."
                },
                "@schematics/angular:pipe": {
                    "typeSeparator": "."
                },
                "@schematics/angular:resolver": {
                    "typeSeparator": "."
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "defaultConfiguration": "production",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/ui/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/ui/tsconfig.lib.json"
                        }
                    }
                },
                "test-build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "tsConfig": "projects/ui/tsconfig.spec.json",
                        "styles": ["@dnd-mapp/design-tokens/tokens.css"]
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "defaultConfiguration": "development",
                    "options": {
                        "buildTarget": "ui:test-build",
                        "tsConfig": "projects/ui/tsconfig.spec.json",
                        "runnerConfig": "vitest.config.ts",
                        "browsers": ["chromium"],
                        "headless": true,
                        "coverage": true,
                        "coverageInclude": ["projects/ui/src/**/*.{ts,html}", "projects/ui/components/**/*.{ts,html}"],
                        "coverageExclude": ["projects/ui/**/index.ts", "projects/ui/**/*.stories.ts"],
                        "coverageReporters": ["text-summary", "html"],
                        "coverageThresholds": {
                            "branches": 80,
                            "functions": 80,
                            "lines": 80,
                            "statements": 80
                        },
                        "reporters": ["dot"]
                    },
                    "configurations": {
                        "ci": {
                            "reporters": ["dot", "github-actions"],
                            "watch": false
                        },
                        "development": {
                            "ui": true,
                            "watch": true
                        }
                    }
                },
                "storybook": {
                    "builder": "@storybook/angular-vite:start-storybook",
                    "options": {
                        "port": 6006,
                        "styles": [
                            "@dnd-mapp/design-tokens/fonts.css",
                            "@dnd-mapp/design-tokens/tokens.css",
                            ".storybook/preview.scss"
                        ]
                    }
                },
                "build-storybook": {
                    "builder": "@storybook/angular-vite:build-storybook",
                    "options": {
                        "outputDir": "dist/storybook",
                        "styles": [
                            "@dnd-mapp/design-tokens/fonts.css",
                            "@dnd-mapp/design-tokens/tokens.css",
                            ".storybook/preview.scss"
                        ]
                    }
                }
            }
        }
    }
}
