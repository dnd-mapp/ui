{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "analytics": false,
        "packageManager": "pnpm"
    },
    "newProjectRoot": "projects",
    "projects": {
        "ui": {
            "projectType": "library",
            "root": "projects/ui",
            "sourceRoot": "projects/ui/src",
            "prefix": "dma",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "defaultConfiguration": "production",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/ui/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/ui/tsconfig.lib.json"
                        }
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "defaultConfiguration": "development",
                    "options": {
                        "tsConfig": "projects/ui/tsconfig.spec.json",
                        "runnerConfig": "vitest.config.ts",
                        "browsers": ["chromium"],
                        "headless": true,
                        "coverage": true,
                        "coverageInclude": ["projects/ui/src/**/*.ts"],
                        "coverageExclude": ["projects/ui/src/index.ts"],
                        "coverageReporters": ["text-summary", "html"],
                        "coverageThresholds": {
                            "branches": 80,
                            "functions": 80,
                            "lines": 80,
                            "statements": 80
                        },
                        "reporters": ["dot"]
                    },
                    "configurations": {
                        "ci": {
                            "reporters": ["dot", "github-actions"],
                            "watch": false
                        },
                        "development": {
                            "ui": true,
                            "watch": true
                        }
                    }
                }
            }
        }
    }
}
