{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@dnd-mapp/config-typescript/base",
    "references": [
        { "path": "./projects/ui/tsconfig.lib.json" },
        { "path": "./projects/ui/tsconfig.spec.json" },
        { "path": "./.storybook/tsconfig.json" },
        { "path": "./tsconfig.tools.json" }
    ],
    "files": [],
    "compilerOptions": {
        "experimentalDecorators": true,
        "importHelpers": true,
        "module": "preserve",
        "target": "es2022",
        "paths": {
            "@dnd-mapp/ui": ["./projects/ui/src/index.ts"],
            "@dnd-mapp/ui/src/components": ["./projects/ui/src/components/index.ts"],
            "@dnd-mapp/ui/src/components/testing": ["./projects/ui/src/components/testing/index.ts"]
        }
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictStandalone": true,
        "strictTemplates": true
    }
}
